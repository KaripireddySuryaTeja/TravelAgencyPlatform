# Copy these into your shell / IDE run configuration (Spring reads them as environment variables).
# NEVER commit real values.

# --- Required ---
MONGO_URI=mongodb://localhost:27017/travelagency
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# 32-byte AES key, base64-encoded. Generate: openssl rand -base64 32
DOCUMENTS_ENCRYPTION_KEY_BASE64=
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
RABBITMQ_HOST=localhost

# --- Seed data (leave empty to get a random password printed at startup) ---
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=

# --- Optional ---
APP_SERVER_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APP_RABBITMQ_ENABLED=false
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-s3-bucket-name
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
